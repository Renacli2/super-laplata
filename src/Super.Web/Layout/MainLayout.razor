@inherits LayoutComponentBase
@inject ApiClient Api

<div class="shell">
    <header class="masthead">
        <a class="wordmark" href="" aria-label="Super, ir a tu lista">
            <span class="wordmark-name">Super</span>
            <span class="wordmark-place">La Plata</span>
        </a>
        @if (_status is { Chains.Count: > 0 } s)
        {
            <p class="freshness">Precios del @Format.Date(s.Chains.Min(c => c.PriceDate))</p>
        }
        else if (_statusFailed)
        {
            <p class="freshness freshness-off">Sin conexión</p>
        }
    </header>

    <main class="page">
        @Body
    </main>
</div>

@code {
    private StatusDto? _status;
    private bool _statusFailed;

    protected override async Task OnInitializedAsync()
    {
        _status = await Api.StatusAsync();
        _statusFailed = _status is null;
    }
}

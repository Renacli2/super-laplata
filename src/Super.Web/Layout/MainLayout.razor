@inherits LayoutComponentBase
@inject DataStore Data
@inject Settings Settings

<div class="shell">
    <header class="masthead">
        <a class="wordmark" href="" aria-label="Super, ir a la lista">
            <span class="wordmark-name">Super</span>
            <span class="wordmark-place">La Plata</span>
        </a>
        <a class="masthead-link" href="ajustes">@(Settings.IsAdmin ? "Admin" : (Settings.Name.Length > 0 ? Settings.Name : "Ajustes"))</a>
    </header>

    <main class="page">
        @Body
    </main>

    @if (_version is { } v)
    {
        <footer class="footer">Productos y precios del @Format.Date(v.PriceDate), según SEPA.</footer>
    }
    else if (_loaded)
    {
        <footer class="footer footer-off">Sin conexión: se usan los últimos datos guardados.</footer>
    }
</div>

@code {
    private DataVersionDto? _version;
    private bool _loaded;

    protected override async Task OnInitializedAsync()
    {
        Settings.Changed += StateHasChanged;
        await Settings.LoadAsync();
        _version = await Data.GetVersionAsync();
        _loaded = true;
    }
}

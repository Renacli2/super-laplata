@page "/comparar"
@implements IDisposable
@inject DataStore Data
@inject CartState Cart

<PageTitle>Dónde comprar · Super</PageTitle>

<a class="back" href="">Volver a la lista</a>

@if (_loading)
{
    <h1 class="page-title">Comparando precios…</h1>
}
else if (_error is not null)
{
    <h1 class="page-title">No pudimos comparar la lista</h1>
    <p class="notice notice-error" role="alert">@_error</p>
    <button type="button" class="btn btn-primary" @onclick="LoadAsync">Probar de nuevo</button>
}
else if (_result is null || Cart.Count == 0 || _result.Recommended is null)
{
    <h1 class="page-title">@(Cart.Count == 0 ? "La lista está vacía" : "Ningún producto tiene precio")</h1>
    <p class="cart-empty">Agregá productos o abrí los pedidos que te mandaron para ver en qué supermercado conviene comprar.</p>
    <a class="btn btn-primary" href="">Ir a la lista</a>
}
else
{
    var r = _result;
    var rec = r.Recommended;
    var selected = _selected ?? rec;
    var complete = r.Options.Where(o => o.IsComplete).ToList();
    var incomplete = r.Options.Where(o => !o.IsComplete).ToList();

    <section class="tag" aria-labelledby="verdict">
        <h1 id="verdict" class="tag-verdict">
            @(rec.StoreCount == 1 ? $"Comprá todo en {StoreList(rec)}" : $"Comprá en {StoreList(rec)}")
        </h1>
        <p class="tag-price" aria-label="Total @Format.Money(rec.Total)">
            <span class="tag-currency">$</span><span class="tag-amount">@Format.Amount(decimal.Truncate(rec.Total))</span><span class="tag-cents">@Format.Cents(rec.Total)</span>
        </p>
        @foreach (var line in Weighting(r))
        {
            <p class="tag-note">@line</p>
        }
    </section>

    <section aria-labelledby="options-title">
        <h2 id="options-title" class="section-title">Opciones de compra</h2>
        <ul class="options" role="radiogroup" aria-label="Opciones de compra">
            @foreach (var o in complete)
            {
                <li>
                    <button type="button" role="radio" aria-checked="@(o == selected ? "true" : "false")"
                            aria-label="@OptionLabel(r, o)" class="option @(o == selected ? "is-selected" : "")" @onclick="() => _selected = o">
                        <span class="option-stores">
                            @foreach (var s in o.Stores) { <span class="dot @Format.ChainClass(s.ToString())" aria-hidden="true"></span> }
                            @StoreNames(o, " + ")
                        </span>
                        <span class="option-total">@Format.Money(o.Total)</span>
                        <span class="option-diff">
                            @if (o == r.Cheapest) { <text>La más barata</text> }
                            else { <text>@Format.Money(o.Total - r.Cheapest!.Total) más (@Format.Percent(r.GapToCheapest(o)!.Value))</text> }
                            @if (o == rec) { <span class="badge">Recomendada</span> }
                        </span>
                    </button>
                </li>
            }
            @if (incomplete.Count > 0)
            {
                <li class="options-note">No completan la lista</li>
                @foreach (var o in incomplete)
                {
                    <li>
                        <button type="button" role="radio" aria-checked="@(o == selected ? "true" : "false")"
                                aria-label="@OptionLabel(r, o)" class="option is-incomplete @(o == selected ? "is-selected" : "")" @onclick="() => _selected = o">
                            <span class="option-stores">
                                @foreach (var s in o.Stores) { <span class="dot @Format.ChainClass(s.ToString())" aria-hidden="true"></span> }
                                @StoreNames(o, " + ")
                            </span>
                            <span class="option-total">@Format.Money(o.Total)</span>
                            <span class="option-diff">Falta@(o.MissingEans.Count == 1 ? "" : "n") @Format.Products(o.MissingEans.Count)</span>
                        </button>
                    </li>
                }
            }
        </ul>
    </section>

    <section aria-labelledby="plan-title">
        <h2 id="plan-title" class="section-title">Qué llevar</h2>
        @if (selected != rec)
        {
            <p class="fine-print">Estás viendo la opción @StoreNames(selected, " + "). <button type="button" class="link-button inline" @onclick="() => _selected = null">Volver a la recomendada</button></p>
        }
        @if (Cart.InCartCount > 0)
        {
            <p class="progress" role="status">
                @Cart.InCartCount de @Format.Products(Cart.Count) en el changuito.
                <button type="button" class="link-button" @onclick="Cart.ClearInCartAsync">Destildar todo</button>
            </p>
        }
        else
        {
            <p class="fine-print">Tildá cada producto cuando lo pongas en el changuito. Lo tildado se mantiene aunque cambies de opción o agregues productos.</p>
        }

        @foreach (var (chain, lines) in selected.Plan)
        {
            <div class="plan @Format.ChainClass(chain.ToString())">
                <h3 class="plan-head">
                    <span>@chain.DisplayName()</span>
                    <span>@Format.Money(lines.Sum(l => l.Total))</span>
                </h3>
                <ul class="plan-lines">
                    @foreach (var line in lines)
                    {
                        @PlanLine(line.Ean, line.Quantity, line.Total)
                    }
                </ul>
            </div>
        }

        @if (selected.MissingEans.Count > 0)
        {
            <div class="plan plan-missing">
                <h3 class="plan-head"><span>No lo venden en @StoreNames(selected, " ni ")</span></h3>
                <ul class="plan-lines">
                    @foreach (var ean in selected.MissingEans)
                    {
                        @PlanLine(ean, Item(ean)?.Quantity ?? 1, null)
                    }
                </ul>
            </div>
        }
    </section>

    @if (r.UnavailableEans.Count > 0)
    {
        <section aria-labelledby="missing-title">
            <h2 id="missing-title" class="section-title">Sin precio en ninguna cadena</h2>
            <ul class="missing">
                @foreach (var ean in r.UnavailableEans)
                {
                    @PlanLine(ean, Item(ean)?.Quantity ?? 1, null)
                }
            </ul>
            <p class="fine-print">No entran en ningún total. Comprálos donde te quede cómodo.</p>
        </section>
    }

    <p class="fine-print">
        Precio de lista más bajo entre las sucursales de La Plata, según SEPA; las promociones todavía no se cuentan.
        Se recomienda ir a menos supermercados salvo que el ahorro supere el @Format.Percent(r.Threshold).
    </p>
}

@code {
    private PurchaseOptionsResult? _result;
    private PurchaseOption? _selected;
    private string? _error;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        Cart.Changed += StateHasChanged;
        await Cart.LoadAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        _selected = null;
        try
        {
            if (Cart.Count == 0)
            {
                _result = null;
                return;
            }
            var prices = await Data.GetPricesAsync();
            var cart = Cart.Items.Select(i => new CartLine(i.Ean, i.Quantity)).ToList();
            _result = new PurchaseOptionsEngine().Compute(cart, DataStore.QuotesFor(prices, cart.Select(c => c.Ean)));
        }
        catch (DataException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private RenderFragment PlanLine(string ean, int quantity, decimal? total) => __builder =>
    {
        var item = Item(ean);
        var inCart = item?.InCart == true;
        <li class="plan-line @(inCart ? "is-picked" : "")">
            <label>
                <input type="checkbox" checked="@inCart" @onchange="e => Cart.SetInCartAsync(ean, e.Value is true)" />
                <span class="plan-qty">@quantity ×</span>
                <span class="plan-name">
                    @(item?.Description ?? ean)
                    @if (item is { RequestedBy.Count: > 0 })
                    {
                        <span class="requested">para @string.Join(" y ", item.RequestedBy)</span>
                    }
                </span>
            </label>
            @if (total is { } t)
            {
                <span class="plan-price">@Format.Money(t)</span>
            }
        </li>
    };

    private CartItem? Item(string ean) => Cart.Items.FirstOrDefault(i => Ean.Normalize(i.Ean) == ean);

    private static string StoreNames(PurchaseOption o, string separator) =>
        string.Join(separator, o.Stores.Select(s => s.DisplayName()));

    /// <summary>"Carrefour", "Carrefour y COTO", "Carrefour, Changomás y COTO".</summary>
    private static string StoreList(PurchaseOption o)
    {
        var names = o.Stores.Select(s => s.DisplayName()).ToList();
        return names.Count <= 1 ? string.Concat(names) : string.Join(", ", names[..^1]) + " y " + names[^1];
    }

    private static string Supermarkets(int count) => count == 1 ? "1 supermercado" : $"{count} supermercados";

    private static string OptionLabel(PurchaseOptionsResult r, PurchaseOption o)
    {
        var detail = !o.IsComplete ? $"faltan {Format.Products(o.MissingEans.Count)}"
            : o == r.Cheapest ? "la más barata"
            : $"{Format.Money(o.Total - r.Cheapest!.Total)} más";
        return $"{StoreList(o)}: {Format.Money(o.Total)}, {detail}{(o == r.Recommended ? ", recomendada" : "")}";
    }

    /// <summary>Ponderación de la recomendación: cuánto se ahorra o se resigna según a cuántos supermercados se va.</summary>
    private static IEnumerable<string> Weighting(PurchaseOptionsResult r)
    {
        var rec = r.Recommended!;
        var cheapest = r.Cheapest!;

        if (cheapest != rec)
        {
            yield return $"Yendo a {Supermarkets(cheapest.StoreCount)} ({StoreNames(cheapest, " + ")}) ahorrarías " +
                         $"{Format.Money(rec.Total - cheapest.Total)} ({Format.Percent(r.GapToCheapest(rec)!.Value)}): " +
                         $"no vale la vuelta extra por menos del {Format.Percent(r.Threshold)}.";
        }

        // Lo que costaría ir a menos supermercados: la mejor opción completa con cada cantidad menor.
        var fewer = Enumerable.Range(1, rec.StoreCount - 1)
            .Reverse()
            .Select(k => r.Options.FirstOrDefault(o => o.IsComplete && o.StoreCount == k))
            .OfType<PurchaseOption>()
            .ToList();
        foreach (var alt in fewer)
        {
            var extra = alt.Total - rec.Total;
            var what = alt.StoreCount == 1
                ? $"Comprar todo en {StoreList(alt)}, el mejor de un solo supermercado,"
                : $"La mejor opción con {Supermarkets(alt.StoreCount)} ({StoreNames(alt, " + ")})";
            yield return $"{what} cuesta {Format.Money(extra)} más ({Format.Percent(extra / rec.Total)}).";
        }
        if (rec.StoreCount > 1 && r.BestSingleStore is null)
        {
            yield return "Ningún supermercado tiene toda la lista: así la completás gastando lo menos posible.";
        }
        if (rec.StoreCount == 1 && cheapest == rec)
        {
            yield return "Es la opción más barata: repartir la compra no ahorra nada.";
        }

        var priciest = r.Options.Where(o => o.IsComplete).MaxBy(o => o.Total);
        if (priciest is not null && priciest.Total > rec.Total)
            yield return $"Frente a la opción más cara de la lista gastás {Format.Money(priciest.Total - rec.Total)} menos.";
    }

    public void Dispose() => Cart.Changed -= StateHasChanged;
}

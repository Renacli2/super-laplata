@page "/comparar"
@implements IDisposable
@inject DataStore Data
@inject CartState Cart

<PageTitle>Dónde comprar · Super</PageTitle>

<a class="back" href="">Volver a la lista</a>

@if (_loading)
{
    <h1 class="page-title">Comparando precios…</h1>
}
else if (_error is not null)
{
    <h1 class="page-title">No pudimos comparar la lista</h1>
    <p class="notice notice-error" role="alert">@_error</p>
    <button type="button" class="btn btn-primary" @onclick="LoadAsync">Probar de nuevo</button>
}
else if (_result is null || Cart.Count == 0)
{
    <h1 class="page-title">La lista está vacía</h1>
    <p class="cart-empty">Agregá productos o abrí los pedidos que te mandaron para ver en qué supermercado conviene comprar.</p>
    <a class="btn btn-primary" href="">Ir a la lista</a>
}
else
{
    var r = _result;
    var stores = r.Plan.Count;
    var complete = r.ChainSummaries.Where(c => c.Total.HasValue).ToList();
    var priciest = complete.Count > 0 ? complete.Max(c => c.Total!.Value) : (decimal?)null;
    var payTotal = r.RecommendSingleStore ? r.BestSingleTotal!.Value : r.SplitTotal;

    <section class="tag" aria-labelledby="verdict">
        <h1 id="verdict" class="tag-verdict">
            @if (r.RecommendSingleStore) { <text>Comprá todo en @r.BestSingleChain!.Value.DisplayName()</text> }
            else if (r.BestSingleChain is null) { <text>Ninguna cadena tiene todo: repartí la compra</text> }
            else { <text>Repartí la compra en @stores supermercados</text> }
        </h1>
        <p class="tag-price" aria-label="Total @Format.Money(payTotal)">
            <span class="tag-currency">$</span><span class="tag-amount">@Format.Amount(decimal.Truncate(payTotal))</span><span class="tag-cents">@Format.Cents(payTotal)</span>
        </p>
        <p class="tag-note">@Note(r)</p>
        @if (priciest is { } max && max > payTotal)
        {
            <p class="tag-note">Frente a la cadena más cara gastás @Format.Money(max - payTotal) menos.</p>
        }
    </section>

    <section aria-labelledby="chains-title">
        <h2 id="chains-title" class="section-title">Toda la lista en cada cadena</h2>
        <ul class="chains">
            @foreach (var c in r.ChainSummaries.OrderBy(c => c.Total ?? decimal.MaxValue))
            {
                var width = c.Total is { } t && priciest is { } m && m > 0 ? (int)Math.Round(t / m * 100) : 0;
                <li class="chain @Format.ChainClass(c.Chain.ToString()) @(c.Total is null ? "chain-incomplete" : "")">
                    <span class="chain-name">@c.Chain.DisplayName()</span>
                    <span class="chain-total">
                        @if (c.Total is { } total) { @Format.Money(total) }
                        else { <text>Le faltan @(c.TotalItems - c.CoveredItems) de @c.TotalItems</text> }
                    </span>
                    <span class="chain-bar" style="--w:@(width)%" aria-hidden="true"></span>
                </li>
            }
        </ul>
    </section>

    <section aria-labelledby="plan-title">
        <h2 id="plan-title" class="section-title">@(stores == 1 ? "Qué llevar" : "Qué llevar en cada uno")</h2>
        @if (Cart.InCartCount > 0)
        {
            <p class="progress" role="status">
                @Cart.InCartCount de @Format.Products(Cart.Count) en el changuito.
                <button type="button" class="link-button" @onclick="Cart.ClearInCartAsync">Destildar todo</button>
            </p>
        }
        else
        {
            <p class="fine-print">Tildá cada producto cuando lo pongas en el changuito. Si después agregás algo a la lista y volvés a comparar, lo tildado se mantiene.</p>
        }
        @foreach (var (chain, lines) in r.Plan)
        {
            <div class="plan @Format.ChainClass(chain.ToString())">
                <h3 class="plan-head">
                    <span>@chain.DisplayName()</span>
                    <span>@Format.Money(lines.Sum(l => l.Total))</span>
                </h3>
                <ul class="plan-lines">
                    @foreach (var line in lines)
                    {
                        var item = Item(line.Ean);
                        var inCart = item?.InCart == true;
                        <li class="plan-line @(inCart ? "is-picked" : "")">
                            <label>
                                <input type="checkbox" checked="@inCart" @onchange="e => Cart.SetInCartAsync(line.Ean, e.Value is true)" />
                                <span class="plan-qty">@line.Quantity ×</span>
                                <span class="plan-name">
                                    @(item?.Description ?? line.Ean)
                                    @if (item is { RequestedBy.Count: > 0 })
                                    {
                                        <span class="requested">para @string.Join(" y ", item.RequestedBy)</span>
                                    }
                                </span>
                            </label>
                            <span class="plan-price">@Format.Money(line.Total)</span>
                        </li>
                    }
                </ul>
            </div>
        }
    </section>

    @if (r.UnavailableEans.Count > 0)
    {
        <section aria-labelledby="missing-title">
            <h2 id="missing-title" class="section-title">Sin precio en ninguna cadena</h2>
            <ul class="missing">
                @foreach (var ean in r.UnavailableEans)
                {
                    var item = Item(ean);
                    var inCart = item?.InCart == true;
                    <li class="plan-line @(inCart ? "is-picked" : "")">
                        <label>
                            <input type="checkbox" checked="@inCart" @onchange="e => Cart.SetInCartAsync(ean, e.Value is true)" />
                            <span class="plan-qty">@(item?.Quantity ?? 1) ×</span>
                            <span class="plan-name">@(item?.Description ?? ean)</span>
                        </label>
                    </li>
                }
            </ul>
            <p class="fine-print">No entran en ningún total. Comprálos donde te quede cómodo.</p>
        </section>
    }

    <p class="fine-print">
        Precio de lista más bajo entre las sucursales de La Plata, según SEPA;
        las promociones todavía no se cuentan. Si repartir ahorra @Format.Percent(r.Threshold) o menos, te sugerimos un solo supermercado.
    </p>
}

@code {
    private ComparisonResult? _result;
    private string? _error;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        Cart.Changed += StateHasChanged;
        await Cart.LoadAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            if (Cart.Count == 0)
            {
                _result = null;
                return;
            }
            var prices = await Data.GetPricesAsync();
            var cart = Cart.Items.Select(i => new CartLine(i.Ean, i.Quantity)).ToList();
            _result = new ComparisonEngine().Compare(cart, DataStore.QuotesFor(prices, cart.Select(c => c.Ean)));
        }
        catch (DataException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private CartItem? Item(string ean) => Cart.Items.FirstOrDefault(i => Ean.Normalize(i.Ean) == ean);

    public void Dispose() => Cart.Changed -= StateHasChanged;

    private static string Note(ComparisonResult r)
    {
        if (r.RecommendSingleStore)
        {
            var extra = r.BestSingleTotal!.Value - r.SplitTotal;
            return extra <= 0
                ? "Tiene el precio más bajo en todos los productos de la lista."
                : $"Repartiendo ahorrarías {Format.Money(extra)} ({Format.Percent(r.Gap!.Value)}), no vale la vuelta extra.";
        }
        if (r.BestSingleTotal is { } single)
            return $"Ahorrás {Format.Money(single - r.SplitTotal)} ({Format.Percent(r.Gap!.Value)}) frente a comprar todo en {r.BestSingleChain!.Value.DisplayName()}.";
        return "Cada producto en la cadena donde sale menos.";
    }
}

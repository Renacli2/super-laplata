@page "/comparar"
@implements IDisposable
@inject DataStore Data
@inject CartState Cart

<PageTitle>Dónde comprar · Super</PageTitle>

<a class="back" href="">Volver a la lista</a>

@if (_loading)
{
    <h1 class="page-title">Comparando precios…</h1>
}
else if (_error is not null)
{
    <h1 class="page-title">No pudimos comparar la lista</h1>
    <p class="notice notice-error" role="alert">@_error</p>
    <button type="button" class="btn btn-primary" @onclick="LoadAsync">Probar de nuevo</button>
}
else if (_result is null || Cart.Count == 0 || _result.Recommended is null)
{
    <h1 class="page-title">@(Cart.Count == 0 ? "La lista está vacía" : "Ningún producto tiene precio")</h1>
    <p class="cart-empty">Agregá productos o abrí los pedidos que te mandaron para ver en qué supermercado conviene comprar.</p>
    <a class="btn btn-primary" href="">Ir a la lista</a>
}
else
{
    var r = _result;
    var rec = r.Recommended;
    var selected = _selected ?? rec;

    <section class="tag" aria-labelledby="verdict">
        <h1 id="verdict" class="tag-verdict">@Verdict(rec)</h1>
        <p class="tag-price" aria-label="Total @Format.Money(rec.FullTotal)">
            <span class="tag-currency">$</span><span class="tag-amount">@Format.Amount(decimal.Truncate(rec.FullTotal))</span><span class="tag-cents">@Format.Cents(rec.FullTotal)</span>
        </p>
        @if (Data.IsStale && Data.Version is { } version)
        {
            <p class="tag-note tag-warn">Precios de @Freshness.Ago(Data.AgeInDays!.Value) (@Format.Date(version.PriceDate)): pueden haber cambiado.</p>
        }
        @foreach (var line in Weighting(r))
        {
            <p class="tag-note">@line</p>
        }
    </section>

    @if (_equivalentCount > 0)
    {
        <p class="notice eq-summary">
            Cambiando @Format.Products(_equivalentCount) por equivalentes más baratos ahorrarías hasta @Format.Money(decimal.Round(_equivalentSaving)).
            <a class="link-button inline" href="">Revisarlos en la lista</a>
        </p>
    }

    <section aria-labelledby="options-title">
        <h2 id="options-title" class="section-title">Opciones de compra</h2>
        <p class="fine-print">Todas por la lista entera. Las de fondo de color no tienen todo: lo que falta se suma a su menor precio en otro supermercado.</p>
        <ul class="options" role="radiogroup" aria-label="Opciones de compra">
            @foreach (var o in r.Options)
            {
                <li>
                    <button type="button" role="radio" aria-checked="@(o == selected ? "true" : "false")"
                            aria-label="@OptionLabel(r, o)" @onclick="() => _selected = o"
                            class="option @(o.IsComplete ? "" : "is-incomplete") @(o == selected ? "is-selected" : "")">
                        <span class="option-stores">
                            @foreach (var s in o.IsComplete ? o.MainStores.Concat(o.ShortStops) : o.Stores)
                            {
                                <span class="dot @Format.ChainClass(s.ToString())" aria-hidden="true"></span>
                            }
                            @Title(o)
                        </span>
                        <span class="option-total">@Format.Money(o.FullTotal)</span>
                        @if (!o.IsComplete)
                        {
                            <span class="option-detail">@Format.Money(o.Total) en @StoreList(o)</span>
                            <span class="option-detail option-missing">@MissingSummary(o)</span>
                        }
                        <span class="option-diff">
                            @if (o == r.Cheapest) { <text>La más barata</text> }
                            else { <text>@Format.Money(o.FullTotal - r.Cheapest!.FullTotal) más (@Format.Percent(r.GapToCheapest(o)!.Value))</text> }
                            @if (o == rec) { <span class="badge">Recomendada</span> }
                        </span>
                    </button>
                </li>
            }
        </ul>
    </section>

    <section aria-labelledby="plan-title">
        <h2 id="plan-title" class="section-title">Qué llevar</h2>
        @if (selected != rec)
        {
            <p class="fine-print">Estás viendo la opción @Title(selected). <button type="button" class="link-button inline" @onclick="() => _selected = null">Volver a la recomendada</button></p>
        }
        @if (Cart.InCartCount > 0)
        {
            <p class="progress">
                @Cart.InCartCount de @Format.Products(Cart.Count) en el changuito.
                <button type="button" class="link-button" @onclick="Cart.ClearInCartAsync">Destildar todo</button>
            </p>
        }
        else
        {
            <p class="fine-print">Tildá cada producto cuando lo pongas en el changuito. Lo tildado se mantiene aunque cambies de opción o agregues productos.</p>
        }

        @{ var picked = PickedEans(); }
        @foreach (var (chain, lines, heading) in PlanGroups(selected))
        {
            var group = ShoppingProgress.For(lines, picked);
            <div class="plan @Format.ChainClass(chain.ToString())">
                <h3 class="plan-head">
                    <span>@heading</span>
                    <span>@Format.Money(group.Total)</span>
                </h3>
                @if (group.IsDone)
                {
                    <p class="plan-progress is-done">Listo: está todo en el changuito.</p>
                }
                else if (group.PickedCount > 0)
                {
                    <p class="plan-progress">Llevás @Format.Money(group.PickedTotal) · faltan @Format.Products(group.RemainingCount) por @Format.Money(group.RemainingTotal)</p>
                }
                <ul class="plan-lines">
                    @foreach (var line in lines)
                    {
                        @PlanLine(line.Ean, line.Quantity, line.Total)
                    }
                </ul>
            </div>
        }
    </section>

    @if (r.UnavailableEans.Count > 0)
    {
        <section aria-labelledby="missing-title">
            <h2 id="missing-title" class="section-title">Sin precio en ninguna cadena</h2>
            <ul class="missing">
                @foreach (var ean in r.UnavailableEans)
                {
                    @PlanLine(ean, Item(ean)?.Quantity ?? 1, null)
                }
            </ul>
            <p class="fine-print">No entran en ningún total. Comprálos donde te quede cómodo.</p>
        </section>
    }

    <p class="fine-print">
        Precio de lista más bajo entre las sucursales de La Plata, según SEPA; las promociones todavía no se cuentan,
        así que lo que suma el changuito puede diferir un poco del ticket.
        Se recomienda ir a menos supermercados salvo que el ahorro supere el @Format.Percent(r.Threshold).
    </p>

    var progress = ShoppingProgress.For(selected, PickedEans());
    <div class="action-bar">
        <div class="cart-bar" role="status" aria-live="polite">
            @if (progress.IsDone)
            {
                <span class="cart-bar-main">Listo: todo en el changuito</span>
                <span class="cart-bar-side"><span class="cart-bar-label">Total</span>@Format.Money(progress.PickedTotal)</span>
            }
            else
            {
                <span class="cart-bar-main"><span class="cart-bar-label">En el changuito</span>@Format.Money(progress.PickedTotal)</span>
                <span class="cart-bar-side"><span class="cart-bar-label">Falta · @Format.Products(progress.RemainingCount)</span>@Format.Money(progress.RemainingTotal)</span>
            }
        </div>
    </div>
}

@code {
    private PurchaseOptionsResult? _result;
    private PurchaseOption? _selected;
    private string? _error;
    private bool _loading = true;
    private int _equivalentCount;
    private decimal _equivalentSaving;

    protected override async Task OnInitializedAsync()
    {
        Cart.Changed += StateHasChanged;
        await Cart.LoadAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        _selected = null;
        try
        {
            if (Cart.Count == 0)
            {
                _result = null;
                return;
            }
            var prices = await Data.GetPricesAsync();
            var cart = Cart.Items.Select(i => new CartLine(i.Ean, i.Quantity)).ToList();
            _result = new PurchaseOptionsEngine().Compute(cart, DataStore.QuotesFor(prices, cart.Select(c => c.Ean)));

            // Cuánto se ahorraría cambiando productos por equivalentes (se revisan y cambian en la lista).
            var finder = await Data.GetEquivalentsAsync();
            var savings = cart.Select(c => Ean.Normalize(c.Ean) is { } ean ? finder.SavingFor(ean, c.Quantity) : 0m).Where(s => s > 0).ToList();
            _equivalentCount = savings.Count;
            _equivalentSaving = savings.Sum();
        }
        catch (DataException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private RenderFragment PlanLine(string ean, int quantity, decimal? total) => __builder =>
    {
        var item = Item(ean);
        var inCart = item?.InCart == true;
        <li class="plan-line @(inCart ? "is-picked" : "")">
            <label>
                <input type="checkbox" checked="@inCart" @onchange="e => Cart.SetInCartAsync(ean, e.Value is true)" />
                <span class="plan-qty">@quantity ×</span>
                <span class="plan-name">
                    @(item?.Description ?? ean)
                    @if (item is { RequestedBy.Count: > 0 })
                    {
                        <span class="requested">para @string.Join(" y ", item.RequestedBy)</span>
                    }
                </span>
            </label>
            @if (total is { } t)
            {
                <span class="plan-price">@Format.Money(t)</span>
            }
        </li>
    };

    private CartItem? Item(string ean) => Cart.Items.FirstOrDefault(i => Ean.Normalize(i.Ean) == ean);

    /// <summary>EAN (normalizados, como en el plan) de lo que ya está en el changuito.</summary>
    private HashSet<string> PickedEans() =>
        Cart.Items.Where(i => i.InCart).Select(i => Ean.Normalize(i.Ean)).OfType<string>().ToHashSet(StringComparer.Ordinal);

    /// <summary>"Carrefour", "Carrefour y COTO", "Carrefour, Changomás y COTO".</summary>
    private static string Join(IEnumerable<Chain> chains)
    {
        var names = chains.Select(s => s.DisplayName()).ToList();
        return names.Count <= 1 ? string.Concat(names) : string.Join(", ", names[..^1]) + " y " + names[^1];
    }

    private static string StoreList(PurchaseOption o) => Join(o.Stores);

    private static string Supermarkets(int count) => count == 1 ? "1 supermercado" : $"{count} supermercados";

    /// <summary>"dos compras grandes", "dos compras grandes y una parada corta".</summary>
    private static string Trips(PurchaseOption o)
    {
        string[] words = ["", "una", "dos", "tres"];
        var main = o.MainStores.Count == 1 ? "una compra grande" : $"{words[o.MainStores.Count]} compras grandes";
        var shorts = o.ShortStops.Count switch { 0 => "", 1 => " y una parada corta", var n => $" y {words[n]} paradas cortas" };
        return main + shorts;
    }

    private static int ItemsIn(PurchaseOption o, Chain chain) =>
        (o.Plan.TryGetValue(chain, out var a) ? a.Count : 0) + (o.Complement.TryGetValue(chain, out var b) ? b.Count : 0);

    private static decimal ValueIn(PurchaseOption o, Chain chain) =>
        (o.Plan.TryGetValue(chain, out var a) ? a.Sum(l => l.Total) : 0m)
        + (o.Complement.TryGetValue(chain, out var b) ? b.Sum(l => l.Total) : 0m);

    /// <summary>Nombre de la opción: "Carrefour + COTO", "COTO + parada corta en Changomás", o los del presupuesto si le falta algo.</summary>
    private static string Title(PurchaseOption o)
    {
        if (!o.IsComplete) return string.Join(" + ", o.Stores.Select(s => s.DisplayName()));
        var main = string.Join(" + ", o.MainStores.Select(s => s.DisplayName()));
        return o.ShortStops.Count == 0 ? main : $"{main} + parada corta en {Join(o.ShortStops)}";
    }

    /// <summary>"Falta 1 producto (11,3 % de la compra): $ 3.158 en Changomás".</summary>
    private static string MissingSummary(PurchaseOption o)
    {
        var where = string.Join(", ", o.Complement.Select(kv => $"{Format.Money(kv.Value.Sum(l => l.Total))} en {kv.Key.DisplayName()}"));
        var verb = o.MissingEans.Count == 1 ? "Falta" : "Faltan";
        return $"{verb} {Format.Products(o.MissingEans.Count)} ({Format.Percent(o.MissingShare)} de la compra): {where}";
    }

    private static string Verdict(PurchaseOption o)
    {
        if (!o.IsComplete)
            return $"Comprá en {StoreList(o)} y lo que falta en {Join(o.Complement.Keys)}";
        if (o.ShortStops.Count > 0)
        {
            var items = o.ShortStops.Sum(s => ItemsIn(o, s));
            return $"Comprá en {Join(o.MainStores)} y pasá por {Join(o.ShortStops)} por {Format.Products(items)}";
        }
        return o.MainStores.Count == 1 ? $"Comprá todo en {Join(o.MainStores)}" : $"Comprá en {Join(o.MainStores)}";
    }

    /// <summary>Grupos de "Qué llevar": los supermercados del presupuesto y después donde se completa lo que falta.</summary>
    private static IEnumerable<(Chain Chain, IReadOnlyList<LineResult> Lines, string Heading)> PlanGroups(PurchaseOption o)
    {
        foreach (var (chain, lines) in o.Plan.OrderByDescending(kv => kv.Value.Sum(l => l.Total)))
            yield return (chain, lines, o.ShortStops.Contains(chain) ? $"{chain.DisplayName()} (parada corta)" : chain.DisplayName());
        foreach (var (chain, lines) in o.Complement)
            yield return (chain, lines, $"{chain.DisplayName()}: lo que falta en {StoreList(o)}");
    }

    private static string OptionLabel(PurchaseOptionsResult r, PurchaseOption o)
    {
        var detail = o == r.Cheapest ? "la más barata" : $"{Format.Money(o.FullTotal - r.Cheapest!.FullTotal)} más";
        var missing = o.IsComplete ? "" : $", {MissingSummary(o)}";
        return $"{Title(o)}: {Format.Money(o.FullTotal)}, {detail}{missing}{(o == r.Recommended ? ", recomendada" : "")}";
    }

    /// <summary>
    /// Ponderación de la recomendación: lo que cuesta la opción más barata (si no es la recomendada), lo que costaría
    /// hacer menos vueltas, y el peso de la parada corta o de lo que falta.
    /// </summary>
    private static IEnumerable<string> Weighting(PurchaseOptionsResult r)
    {
        var rec = r.Recommended!;
        var cheapest = r.Cheapest!;

        if (cheapest != rec)
        {
            yield return $"La opción más barata ({Title(cheapest)}) cuesta {Format.Money(rec.FullTotal - cheapest.FullTotal)} menos " +
                         $"({Format.Percent(r.GapToCheapest(rec)!.Value)}): por menos del {Format.Percent(r.Threshold)} conviene la más simple.";

            // Opciones intermedias: más baratas que la recomendada pero con más vueltas (la mejor de cada nivel).
            var between = r.Options
                .Where(o => o != cheapest && r.IsEligible(o) && o.Effort > rec.Effort && o.FullTotal < rec.FullTotal)
                .GroupBy(o => o.Effort)
                .OrderBy(g => g.Key)
                .Select(g => g.MinBy(o => o.FullTotal)!);
            foreach (var alt in between)
            {
                var saving = rec.FullTotal - alt.FullTotal;
                yield return $"{Title(alt)} cuesta {Format.Money(saving)} menos ({Format.Percent(saving / rec.FullTotal)}), " +
                             $"pero con {Trips(alt)}.";
            }
        }

        if (!rec.IsComplete)
        {
            yield return $"{MissingSummary(rec)}.";
        }
        else
        {
            foreach (var s in rec.ShortStops)
            {
                var value = ValueIn(rec, s);
                yield return $"En {s.DisplayName()} llevás {Format.Products(ItemsIn(rec, s))} por {Format.Money(value)} " +
                             $"({Format.Percent(value / rec.FullTotal)} de la compra).";
            }
        }

        // Lo que costaría hacer menos vueltas: la mejor opción recomendable con cada cantidad menor de vueltas.
        var simpler = r.Options
            .Where(o => r.IsEligible(o) && o.Effort < rec.Effort)
            .GroupBy(o => o.Effort)
            .OrderByDescending(g => g.Key)
            .Select(g => g.MinBy(o => o.FullTotal)!)
            .ToList();
        foreach (var alt in simpler)
        {
            var extra = alt.FullTotal - rec.FullTotal;
            var what = alt.IsComplete && alt.MainStores.Count == 1 && alt.ShortStops.Count == 0
                ? $"Comprar todo en {Join(alt.MainStores)}"
                : Title(alt);
            yield return $"{what} cuesta {Format.Money(extra)} más ({Format.Percent(extra / rec.FullTotal)}).";
        }

        if (rec.Effort > 1 && r.BestSingleStore is null && simpler.Count == 0)
            yield return "Ningún supermercado tiene toda la lista.";
        if (rec.Effort == 1 && cheapest == rec)
            yield return "Es la opción más barata: repartir la compra no ahorra nada.";

        var priciest = r.Options.MaxBy(o => o.FullTotal);
        if (priciest is not null && priciest.FullTotal > rec.FullTotal)
            yield return $"Frente a la opción más cara ({Title(priciest)}) gastás {Format.Money(priciest.FullTotal - rec.FullTotal)} menos.";
    }

    public void Dispose() => Cart.Changed -= StateHasChanged;
}

@page "/"
@implements IDisposable
@inject DataStore Data
@inject CartState Cart
@inject FavoritesState Favorites
@inject Settings Settings
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>@(Settings.IsAdmin ? "Lista de compras" : "Tu pedido") · Super</PageTitle>

<h1 class="page-title">@(Settings.IsAdmin ? "Lista de compras" : "Tu pedido")</h1>

<div class="search" role="search">
    <label for="q" class="sr-only">Buscar un producto</label>
    <input id="q" type="search" class="search-input" placeholder="Buscá un producto o escribí su código"
           autocomplete="off" enterkeyhint="search" maxlength="60" disabled="@(_catalog is null)"
           @bind="_query" @bind:event="oninput" @bind:after="OnQueryChangedAsync" />
    @if (_canScan)
    {
        <button type="button" class="scan-button" @onclick="() => _scanning = true" aria-label="Escanear un código de barras"
                disabled="@(_catalog is null)">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7V4h3M18 4h3v3M21 17v3h-3M6 20H3v-3M7 8v8M10 8v8M13 8v8M16 8v8" /></svg>
        </button>
    }
</div>

@if (_catalog is null && _loadError is null)
{
    <p class="results-empty" role="status">Cargando productos…</p>
}

@if (_notice is not null)
{
    <div class="notice @(_noticeIsError ? "notice-error" : "")" role="status">
        <p>@_notice</p>
        @if (_offerClear)
        {
            <button type="button" class="link-button" @onclick="ClearAfterSendAsync">Vaciar mi pedido</button>
        }
    </div>
}

@if (_query.Trim().Length >= 2 && _catalog is not null)
{
    <section class="results" aria-label="Resultados de la búsqueda">
        @if (_results.Count == 0)
        {
            <p class="results-empty">No encontramos "@_query.Trim()" en Carrefour, Changomás ni COTO de La Plata.</p>
        }
        @foreach (var p in _results)
        {
            var inCart = Cart.Contains(p.Ean);
            <article class="result">
                <div class="result-text">
                    <h2 class="result-name">@p.Description</h2>
                    <p class="result-meta">@Meta(p.Brand, p.Presentation)</p>
                </div>
                <div class="result-actions">
                    @Star(p)
                    <button type="button" class="btn @(inCart ? "btn-quiet" : "btn-primary")" @onclick="() => AddAsync(p)"
                            aria-label="@(inCart ? "Sumar uno más de" : "Agregar") @p.Description">
                        @(inCart ? "Uno más" : "Agregar")
                    </button>
                </div>
            </article>
        }
    </section>
}
else if (PendingUsual() is { Count: > 0 } usual)
{
    var shown = _showAllUsual ? usual : usual.Take(UsualPreview).ToList();
    var starred = usual.Where(u => u.IsStarred).ToList();
    <section class="usual" aria-labelledby="usual-title">
        <h2 id="usual-title" class="section-title">Tus habituales</h2>
        @if (starred.Count >= 2)
        {
            <button type="button" class="btn btn-quiet usual-all" @onclick="() => AddAllStarredAsync(starred)">
                Agregar los @starred.Count marcados
            </button>
        }
        <ul class="cart-list">
            @foreach (var f in shown)
            {
                var entry = _catalog?.Find(f.Ean) ?? f.ToEntry();
                var missing = _catalog is not null && _catalog.Find(f.Ean) is null;
                <li class="cart-item usual-item @(missing ? "is-missing" : "")">
                    <div class="cart-text">
                        <span class="cart-name">@(f.Quantity > 1 ? $"{f.Quantity} × " : "")@entry.Description</span>
                        <span class="cart-meta">
                            @Meta(entry.Brand, entry.Presentation)
                            @if (!f.IsStarred)
                            {
                                <span class="usual-why">Sugerido: lo compraste @Times(f.TimesBought)</span>
                            }
                            @if (missing)
                            {
                                <span class="in-cart">No figura en los datos de hoy</span>
                            }
                        </span>
                    </div>
                    <div class="result-actions">
                        @Star(entry, f.Quantity)
                        <button type="button" class="btn btn-quiet" @onclick="() => AddFavoriteAsync(entry, f.Quantity)"
                                aria-label="@AddLabel(entry, f.Quantity)">Agregar</button>
                    </div>
                </li>
            }
        </ul>
        @if (usual.Count > UsualPreview)
        {
            <button type="button" class="link-button" aria-expanded="@(_showAllUsual ? "true" : "false")"
                    @onclick="() => _showAllUsual = !_showAllUsual">
                @(_showAllUsual ? "Ver menos" : $"Ver los {usual.Count} habituales")
            </button>
        }
    </section>
}

<section class="cart" aria-labelledby="cart-title">
    <h2 id="cart-title" class="section-title">
        @if (Cart.Count == 0) { <text>Todavía no hay productos</text> }
        else { <text>@Format.Products(Cart.Count)</text> }
    </h2>

    @if (Cart.Count == 0)
    {
        <p class="cart-empty">
            @if (Settings.IsAdmin)
            {
                <text>Abrí los pedidos que te mandan o agregá productos acá. Antes de salir, comparás y la app te dice en qué supermercado conviene comprar.</text>
            }
            else
            {
                <text>Buscá lo que necesitás@(_canScan ? " o escaneá el código de barras" : "") y mandale el pedido a quien hace las compras.</text>
            }
        </p>
    }
    else
    {
        <ul class="cart-list">
            @foreach (var item in Cart.Items)
            {
                <li class="cart-item">
                    <div class="cart-text">
                        <span class="cart-name">@item.Description</span>
                        <span class="cart-meta">
                            @Meta(item.Brand, item.Presentation)
                            @if (Settings.IsAdmin && item.RequestedBy.Count > 0)
                            {
                                <span class="requested">Pidió @string.Join(" y ", item.RequestedBy)</span>
                            }
                            @if (Settings.IsAdmin && item.InCart)
                            {
                                <span class="in-cart">Ya está en el changuito</span>
                            }
                        </span>
                    </div>
                    @Star(new CatalogEntry(item.Ean, item.Description, item.Brand, item.Presentation), item.Quantity)
                    <div class="stepper" role="group" aria-label="Cantidad de @item.Description">
                        <button type="button" @onclick="() => Cart.SetQuantityAsync(item.Ean, item.Quantity - 1)"
                                aria-label="@(item.Quantity == 1 ? "Quitar" : "Uno menos")">@(item.Quantity == 1 ? "×" : "−")</button>
                        <output aria-live="polite">@item.Quantity</output>
                        <button type="button" @onclick="() => Cart.SetQuantityAsync(item.Ean, item.Quantity + 1)" aria-label="Uno más">+</button>
                    </div>
                    @if (Settings.IsAdmin && _equivalents?.Find(item.Ean) is { Count: > 0 } eqs)
                    {
                        var open = _openEquivalents == item.Ean;
                        var size = _equivalents.SizeOf(item.Ean)!;
                        <div class="eq">
                            <button type="button" class="eq-toggle" aria-expanded="@(open ? "true" : "false")"
                                    @onclick="() => _openEquivalents = open ? null : item.Ean">
                                Hay más baratos: desde @Format.Money(eqs[0].Price) (@Format.Percent(eqs[0].Saving) menos por @size.PerUnitLabel)
                            </button>
                            @if (open)
                            {
                                @if (item.RequestedBy.Count > 0)
                                {
                                    <p class="eq-note">Lo pidió @string.Join(" y ", item.RequestedBy): fijate si quiere esa marca justa.</p>
                                }
                                <ul class="eq-list">
                                    @foreach (var eq in eqs)
                                    {
                                        <li class="eq-item">
                                            <div class="eq-text">
                                                <span class="cart-name">@eq.Product.Description</span>
                                                <span class="cart-meta">
                                                    @Format.Money(eq.Price) · @Format.Money(decimal.Round(eq.PerUnitPrice)) el @(eq.Size.Unit == SizeUnit.Grams ? "kilo" : "litro")
                                                    · @Format.Percent(eq.Saving) menos · en @string.Join(" y ", eq.Chains.Select(c => c.DisplayName()))
                                                </span>
                                            </div>
                                            <button type="button" class="btn btn-quiet" @onclick="() => ReplaceAsync(item, eq)"
                                                    aria-label="Cambiar @item.Description por @eq.Product.Description">Cambiar</button>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    }
                </li>
            }
        </ul>
        <button type="button" class="link-button" @onclick="Cart.ClearAsync">Vaciar la lista</button>
    }
</section>

@if (Cart.Count > 0)
{
    <div class="action-bar">
        @if (Settings.IsAdmin)
        {
            <a class="action-main" href="comparar">
                <span>Comparar precios</span>
                <span class="action-sub">@Format.Products(Cart.Count)</span>
            </a>
        }
        else if (_askName)
        {
            <form class="name-form" @onsubmit="SaveNameAndSendAsync">
                <label for="name">¿Cómo te llamás? Así sabe de quién es el pedido.</label>
                <div class="name-row">
                    <input id="name" class="search-input" maxlength="40" autocomplete="given-name" @bind="_name" />
                    <button type="submit" class="btn btn-primary" disabled="@string.IsNullOrWhiteSpace(_name)">Enviar</button>
                </div>
            </form>
        }
        else
        {
            <button type="button" class="action-main" @onclick="SendAsync">
                <span>Enviar pedido</span>
                <span class="action-sub">@Format.Products(Cart.Count)</span>
            </button>
        }
    </div>
}

@if (_scanning)
{
    <Scanner OnCode="OnScannedAsync" OnClose="() => _scanning = false" />
}

@code {
    private CatalogSearch? _catalog;
    private string? _loadError;
    private string _query = "";
    private IReadOnlyList<CatalogEntry> _results = [];
    private bool _canScan;
    private bool _scanning;
    private string? _notice;
    private bool _noticeIsError;
    private bool _offerClear;
    private bool _askName;
    private string _name = "";
    private CancellationTokenSource? _searchCts;
    private EquivalentFinder? _equivalents;
    private string? _openEquivalents;
    private bool _showAllUsual;

    /// <summary>Habituales que se muestran antes de "Ver los N habituales".</summary>
    private const int UsualPreview = 8;

    protected override async Task OnInitializedAsync()
    {
        Cart.Changed += StateHasChanged;
        Favorites.Changed += StateHasChanged;
        Settings.Changed += StateHasChanged;
        await Settings.LoadAsync();
        await Cart.LoadAsync();
        await Favorites.LoadAsync();
        try { _canScan = await JS.InvokeAsync<bool>("superApp.canScan"); }
        catch (JSException) { _canScan = false; }

        try
        {
            _catalog = await Data.GetCatalogAsync();
        }
        catch (DataException ex)
        {
            _loadError = ex.Message;
            Show(ex.Message, error: true);
        }

        // Equivalentes más baratos: solo el administrador, que es quien ve precios. Si no hay precios, no se muestran.
        if (Settings.IsAdmin && _catalog is not null)
        {
            try { _equivalents = await Data.GetEquivalentsAsync(); }
            catch (DataException) { _equivalents = null; }
        }
    }

    private async Task ReplaceAsync(CartItem item, Equivalent eq)
    {
        var before = item.Description.TrimEnd('.', ' ');
        await Cart.ReplaceAsync(item.Ean, eq.Product);
        _openEquivalents = null;
        Show($"Cambiaste {before} por {eq.Product.Description.TrimEnd('.', ' ')}.");
    }

    private async Task OnQueryChangedAsync()
    {
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var ct = _searchCts.Token;
        if (_catalog is null || _query.Trim().Length < 2)
        {
            _results = [];
            return;
        }
        try
        {
            await Task.Delay(200, ct);
            // Los habituales primero: los marcados y los que se compran seguido.
            _results = _catalog.Search(_query, 20, UsualProducts.PreferredEans(Favorites.Items, Cart.Purchases));
        }
        catch (OperationCanceledException) { }
    }

    private async Task AddAsync(CatalogEntry product)
    {
        await Cart.AddAsync(product);
        Show($"Agregaste {product.Description.TrimEnd('.', ' ')}.");
    }

    private async Task AddFavoriteAsync(CatalogEntry product, int quantity)
    {
        await Cart.AddAsync(product, quantity);
        Show($"Agregaste {(quantity > 1 ? $"{quantity} de " : "")}{product.Description.TrimEnd('.', ' ')}.");
    }

    private static string AddLabel(CatalogEntry product, int quantity) =>
        quantity > 1 ? $"Agregar {quantity} de {product.Description}" : $"Agregar {product.Description}";

    private async Task ToggleFavoriteAsync(CatalogEntry product, int quantity)
    {
        var name = product.Description.TrimEnd('.', ' ');
        var marked = await Favorites.ToggleAsync(product, quantity);
        Show(marked ? $"{name} quedó entre tus habituales." : $"Sacaste {name} de tus habituales.");
    }

    private async Task AddAllStarredAsync(List<UsualProduct> starred)
    {
        await Cart.AddManyAsync(starred.Select(u => (_catalog?.Find(u.Ean) ?? u.ToEntry(), u.Quantity)));
        Show($"Agregaste tus {Format.Products(starred.Count)} habituales.");
    }

    /// <summary>Habituales (marcados y sugeridos por las compras) que todavía no están en la lista.</summary>
    private List<UsualProduct> PendingUsual()
    {
        var inList = Cart.Items.Select(i => Ean.Normalize(i.Ean) ?? i.Ean).ToHashSet(StringComparer.Ordinal);
        return UsualProducts.Build(Favorites.Items, Cart.Purchases, inList);
    }

    private static string Times(int count) => count == 1 ? "1 vez" : $"{count} veces";

    /// <summary>Estrella para marcar o desmarcar un habitual (botón de dos estados).</summary>
    private RenderFragment Star(CatalogEntry product, int quantity = 1) => __builder =>
    {
        var on = Favorites.IsFavorite(product.Ean);
        <button type="button" class="star @(on ? "is-on" : "")" aria-pressed="@(on ? "true" : "false")"
                aria-label="Habitual: @product.Description" title="@(on ? "Sacar de habituales" : "Marcar como habitual")"
                @onclick="() => ToggleFavoriteAsync(product, quantity)">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z" /></svg>
        </button>
    };

    private async Task OnScannedAsync(string code)
    {
        _scanning = false;
        if (_catalog?.Find(code) is { } product) await AddAsync(product);
        else Show($"El código {code} no figura en Carrefour, Changomás ni COTO de La Plata.", error: true);
    }

    private async Task SendAsync()
    {
        if (string.IsNullOrWhiteSpace(Settings.Name))
        {
            _askName = true;
            return;
        }

        var order = Cart.ToOrder(Settings.Name);
        var url = Nav.ToAbsoluteUri(OrderLink.Encode(order)).ToString();
        var text = $"Pedido de {order.From} para el súper ({Format.Products(order.Items.Count)}):";
        var result = await JS.InvokeAsync<string>("superApp.share", "Pedido para el súper", text, url);
        switch (result)
        {
            case "shared":
                Show("Pedido enviado.", offerClear: true);
                break;
            case "copied":
                Show("Copiamos el link del pedido: pegalo en WhatsApp o donde hablen con quien hace las compras.", offerClear: true);
                break;
            case "cancelled":
                break;
            default:
                Show("No se pudo compartir el pedido desde este navegador.", error: true);
                break;
        }
    }

    private async Task SaveNameAndSendAsync()
    {
        await Settings.SetNameAsync(_name);
        _askName = false;
        await SendAsync();
    }

    private async Task ClearAfterSendAsync()
    {
        await Cart.ClearAsync();
        _notice = null;
        _offerClear = false;
    }

    private void Show(string message, bool error = false, bool offerClear = false)
    {
        _notice = message;
        _noticeIsError = error;
        _offerClear = offerClear;
    }

    private static string Meta(string brand, string presentation) =>
        string.Join(", ", new[] { brand, presentation }.Where(s => !string.IsNullOrWhiteSpace(s)));

    public void Dispose()
    {
        Cart.Changed -= StateHasChanged;
        Favorites.Changed -= StateHasChanged;
        Settings.Changed -= StateHasChanged;
        _searchCts?.Cancel();
    }
}
